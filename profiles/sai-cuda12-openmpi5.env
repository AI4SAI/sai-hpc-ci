# Trusted site profile. Projects may select this name but cannot override values.
MODULE_INIT="/etc/profile.d/lmod.sh"
MODULES="cmake/3.31.6 openmpi/5.0.10-nvhpc26.3-gnu-cuda12-auto apptainer/1.4.4"
PARTITION="flood-gpu"
QOS="flood-gpu"
MPI_ROOT="/opt/devtools/openmpi/openmpi-5.0.10-nvhpc263-gnu-cuda12-avx512"
ROOTFS="/opt/sai-ci/rootfs/minimal-v1.sif"
MAX_NODES=2
MAX_GPUS_PER_NODE=8
